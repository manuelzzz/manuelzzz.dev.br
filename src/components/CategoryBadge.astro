---
import { CATEGORY_COLORS, CATEGORY_LABELS } from '../consts';

interface Props {
  category: string;
  as?: 'span' | 'a';
}

const { category, as = 'a' } = Astro.props;
const colorClasses = CATEGORY_COLORS[category] ?? 'text-fg-muted border-fg-muted/40 bg-fg-muted/10';
const label = CATEGORY_LABELS[category] ?? category;
const Tag = as;
---

<Tag
  href={as === 'a' ? `/changelog/category/${category}` : undefined}
  class:list={[
    'inline-flex items-center rounded border px-2 py-0.5 font-mono text-xs',
    colorClasses,
  ]}
>
  {label}
</Tag>
