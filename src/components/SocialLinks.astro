---
import { SOCIAL_LINKS } from '../consts';
---

<ul class="flex flex-wrap gap-x-4 gap-y-2 font-heading text-sm">
  {
    SOCIAL_LINKS.map((link) => (
      <li>
        <a href={link.href} class="text-fg-muted transition-colors hover:text-accent-teal" target="_blank" rel="noopener noreferrer">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
