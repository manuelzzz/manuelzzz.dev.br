---
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  slug: string;
  title: string;
  date: Date;
  category: string;
  summary: string;
}

const { slug, title, date, category, summary } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10);
---

<article class="relative pl-6">
  <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-accent-teal"></span>
  <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-fg-muted">
    <time datetime={formattedDate}>{formattedDate}</time>
    <CategoryBadge category={category} />
  </div>
  <h3 class="mt-1 font-heading text-base text-fg">
    <a href={`/changelog/${slug}`} class="hover:text-accent-teal">{title}</a>
  </h3>
  <p class="mt-1 text-sm text-fg-muted">{summary}</p>
</article>
