---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import ChangelogEntry from '../components/ChangelogEntry.astro';
import TechTag from '../components/TechTag.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import ProofPoints from '../components/ProofPoints.astro';
import MainStack from '../components/MainStack.astro';
import { PERSON_JOB_TITLE, HERO_STACK, SOCIAL_LINKS } from '../consts';

const linkedIn = SOCIAL_LINKS.find((link) => link.label === 'LinkedIn')!;

const allProjects = await getCollection('projects');
// Projetos "em destaque" são simplesmente os ativos — sem flag manual pra manter em dia.
const featuredProjects = allProjects
  .filter((p) => p.data.status === 'ativo')
  .sort((a, b) => a.data.order - b.data.order);

const allChangelog = await getCollection('changelog', ({ data }) => !data.draft);
const latestEntries = allChangelog
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const experiences = [
  {
    role: 'Desenvolvedor Front-End',
    org: 'BiON (Embrapii)',
    period: 'jun 2026 — atual',
    description:
      'Criação do app mobile e do dashboard web de um produto de saúde com IA que ajuda médicos a triar e priorizar pacientes com doenças autoimunes. MVP em testes com ~10 médicos.',
    stack: ['React Native', 'React', 'Expo', 'TypeScript', 'Docker'],
  },
  {
    role: 'Desenvolvedor Mobile e Web',
    org: 'Datacom RN',
    period: 'abr 2025 — abr 2026',
    description:
      'Desenvolvimento de ponta a ponta do app Gestor Educação, usado pela rede municipal de Macaíba/RN. ~15 publicações do app da EALRN entre features e manutenções, e definição de arquitetura/gerenciamento de estado.',
    stack: ['Flutter', 'Clean-Dart', 'Flutter Modular', 'PHP', 'GitHub Actions'],
  },
  {
    role: 'Desenvolvedor Mobile',
    org: 'STI/UFRN',
    period: 'set 2024 — jun 2026',
    description:
      'Manutenção de 7 aplicativos Flutter (iOS e Android) com TDD e Clean-Dart. Refatoração do SIGAA Mobile (+100 mil downloads, +10 mil usuários) para dark mode, e novo sistema de notificações para os apps da STI utilizando background service.',
    stack: ['Flutter', 'Clean-Dart', 'DDD', 'TDD', 'GitLab CI/CD'],
  },
  {
    role: 'Desenvolvedor Fullstack e Mobile',
    org: 'CAURN',
    period: 'jun 2024 — set 2024',
    description:
      'Sistema de eleições internas do CAURN Digital, incluindo endpoint de registro de votos criptografados e emissão de comprovante. Desenvolvimento de um framework interno para geração de PDFs (comprovantes, atas, relatórios).',
    stack: ['Flutter', 'Java', 'Spring', 'Thymeleaf', 'GitLab CI/CD'],
  },
  {
    role: 'Estagiário em Desenvolvimento Mobile',
    org: 'MobyLab',
    period: 'dez 2022 — ago 2023',
    description:
      'Manutenção e desenvolvimento de apps Flutter para sistemas bancários e fintechs com foco em segurança, usando arquiteturas MVC/MVVM com Flutter Modular.',
    stack: ['Flutter', 'Figma'],
  },
];
---

<BaseLayout>
  <section>
    <h1 class="font-heading text-2xl text-fg">Manuel Santos Souza</h1>
    <p class="mt-1 font-mono text-sm text-accent-teal">{PERSON_JOB_TITLE}</p>
    <p class="mt-2 font-mono text-xs text-fg-muted">{HERO_STACK.join(' · ')}</p>
    <p class="mt-4 max-w-xl text-justify text-fg-muted">
      Já trabalhei em produtos de saúde, educação, setor bancário e setor público — do app mobile
      ao dashboard web. Esse é o meu portfólio e changelog pessoal — aqui eu registro projetos,
      experiências e o progresso do que estou construindo e aprendendo.
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <a
        href="/projects"
        class="rounded border border-accent-teal px-3 py-1.5 font-mono text-xs text-accent-teal transition-colors hover:bg-accent-teal/10"
      >
        ver projetos →
      </a>
      <a
        href={linkedIn.href}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded border border-border px-3 py-1.5 font-mono text-xs text-fg-muted transition-colors hover:border-accent-teal hover:text-accent-teal"
      >
        LinkedIn →
      </a>
    </div>
    <div class="mt-4">
      <SocialLinks />
    </div>
  </section>

  <section class="mt-12">
    <ProofPoints />
  </section>

  <section class="mt-12">
    <h2 class="font-heading text-lg text-fg">contribuições</h2>
    <p class="mt-2 text-sm text-fg-muted">
      GitHub + GitLab, unificados via <a href="https://github.com/manuelzzz/DevGrid" class="text-accent-teal hover:underline" target="_blank" rel="noopener noreferrer">DevGrid</a>.
    </p>
    <div class="mt-4">
      <ContributionGraph />
    </div>
  </section>

  <section class="mt-12">
    <h2 class="font-heading text-lg text-fg">experiência</h2>
    <ul class="mt-4 space-y-4 border-l border-border pl-4">
      {
        experiences.map((exp) => (
          <li>
            <p class="font-heading text-sm text-fg">{exp.role} · <span class="text-fg-muted">{exp.org}</span></p>
            <p class="font-mono text-xs text-fg-muted">{exp.period}</p>
            <p class="mt-1 text-sm text-fg-muted">{exp.description}</p>
            <ul class="mt-2 flex flex-wrap gap-2 font-mono text-xs text-fg-muted">
              {exp.stack.map((tech) => <TechTag name={tech} />)}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="font-heading text-lg text-fg">stack principal</h2>
    <div class="mt-4">
      <MainStack />
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="font-heading text-lg text-fg">projetos em destaque</h2>
      <a href="/projects" class="font-mono text-xs text-accent-teal hover:underline">ver todos →</a>
    </div>
    <div class="mt-4">
      <ProjectCarousel projects={featuredProjects} />
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="font-heading text-lg text-fg">últimas do changelog</h2>
      <a href="/changelog" class="font-mono text-xs text-accent-teal hover:underline">ver todas →</a>
    </div>
    <div class="mt-4 space-y-8 border-l border-border pl-2">
      {
        latestEntries.map((entry) => (
          <ChangelogEntry
            slug={entry.id}
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            summary={entry.data.summary}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
