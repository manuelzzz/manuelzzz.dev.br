---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ChangelogEntry from '../components/ChangelogEntry.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allChangelog = await getCollection('changelog', ({ data }) => !data.draft);
const latestEntries = allChangelog
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// TODO: revise esse texto de apresentação
const experiences = [
  {
    role: 'Cargo / Título',
    org: 'Empresa',
    period: '20XX — atual',
    description: 'Breve descrição do que você faz nessa posição.',
  },
];
---

<BaseLayout>
  <section>
    <h1 class="font-heading text-2xl text-fg">Manuel Souza</h1>
    <p class="mt-3 max-w-xl text-fg-muted">
      <!-- TODO: escreva sua bio real -->
      Desenvolvedor. Esse é o meu portfólio e changelog pessoal — aqui eu registro projetos,
      experiências e o progresso do que estou construindo e aprendendo.
    </p>
    <div class="mt-4">
      <SocialLinks />
    </div>
  </section>

  <section class="mt-12">
    <h2 class="font-heading text-lg text-fg">experiência</h2>
    <ul class="mt-4 space-y-4 border-l border-border pl-4">
      {
        experiences.map((exp) => (
          <li>
            <p class="font-heading text-sm text-fg">{exp.role} · <span class="text-fg-muted">{exp.org}</span></p>
            <p class="font-mono text-xs text-fg-muted">{exp.period}</p>
            <p class="mt-1 text-sm text-fg-muted">{exp.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="font-heading text-lg text-fg">projetos em destaque</h2>
      <a href="/projects" class="font-mono text-xs text-accent-teal hover:underline">ver todos →</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="font-heading text-lg text-fg">últimas do changelog</h2>
      <a href="/changelog" class="font-mono text-xs text-accent-teal hover:underline">ver todas →</a>
    </div>
    <div class="mt-4 space-y-8 border-l border-border pl-2">
      {
        latestEntries.map((entry) => (
          <ChangelogEntry
            slug={entry.id}
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            summary={entry.data.summary}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
