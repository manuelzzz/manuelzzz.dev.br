---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NowSection from '../components/NowSection.astro';

const entry = await getEntry('now', 'now');
const { updatedAt, currently, learning, exploring } = entry!.data;
const formattedDate = updatedAt.toISOString().slice(0, 10);
---

<BaseLayout title="now" description="O que estou fazendo, aprendendo e explorando agora.">
  <h1 class="font-heading text-2xl text-fg">agora</h1>
  <p class="mt-2 font-mono text-xs text-fg-muted">
    última atualização: <time datetime={formattedDate}>{formattedDate}</time>
  </p>

  <NowSection heading="atualmente" items={currently} />
  <NowSection heading="aprendendo" items={learning} />
  <NowSection heading="explorando" items={exploring} />

  <p class="mt-10 border-t border-border pt-4 text-xs text-fg-muted">
    Inspirado na ideia da <a href="https://nownownow.com/about" class="text-accent-teal hover:underline" target="_blank" rel="noopener noreferrer">now page</a>.
  </p>
</BaseLayout>
